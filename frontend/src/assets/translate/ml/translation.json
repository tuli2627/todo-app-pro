  "faq": {
    "title": "പതിവായി ചോദിക്കുന്ന ചോദ്യങ്ങൾ (FAQs)",
    "items": {
      "1": { "question": "ഈ പോർട്ടലിന്റെ ഉദ്ദേശ്യം എന്താണ്?", "answer": "വന നഴ്സറികളും നടീൽ വസ്തുക്കളും ആസൂത്രണം ചെയ്യാനും പിന്തുടരാനും നിരീക്ഷിക്കാനുമുള്ള കേന്ദ്ര ഡിജിറ്റൽ വേദിയാണിത്." },
      "2": { "question": "ഈ പ്ലാറ്റ്ഫോം എന്തെല്ലാം സേവനങ്ങൾ നൽകുന്നു?", "answer": "നിലവിലുള്ള നഴ്സറികളുടെ മാപ്പിംഗ്, നടീൽ വസ്തുക്കളുടെ പൂർണ്ണമായ പിന്തുടർച്ച, സവിശേഷ QR കോഡ് സൃഷ്ടിക്കൽ എന്നിവ ഉൾപ്പെടുന്നു." },
      "3": { "question": "ഈ പ്ലാറ്റ്ഫോമിന്റെ സവിശേഷതകൾ എന്തൊക്കെയാണ്?", "answer": "ഓരോ സ്ഥാപനത്തിനും സവിശേഷ കോഡും വിവിധ അധികാരികൾക്ക് ചുമതല അടിസ്ഥാനമാക്കിയ പ്രവർത്തനക്രമവും നൽകുന്നു." },
      "4": { "question": "ആർക്കൊക്കെ ഈ പ്ലാറ്റ്ഫോം ഉപയോഗിക്കാം?", "answer": "വനവകുപ്പുകൾ, നഴ്സറി മാനേജർമാർ, അംഗീകൃത സർക്കാർ ഉദ്യോഗസ്ഥർ എന്നിവർക്ക് ഇത് ഉപയോഗിക്കാം." },
      "5": { "question": "ഉപയോക്തൃ രജിസ്ട്രേഷൻ നിർബന്ധമാണോ?", "answer": "അതെ. ചുമതല അടിസ്ഥാനമാക്കിയ ഡാഷ്ബോർഡ് ഉപയോഗിക്കാൻ അംഗീകൃത ജീവനക്കാർ രജിസ്റ്റർ ചെയ്യണം." },
      "6": { "question": "വിത്തുൽപ്പാദന മേഖല (SPA) എന്താണ്?", "answer": "വനമേഖലയ്ക്കായി ഉയർന്ന ഗുണമേന്മയുള്ള വിത്തുകൾ ഉൽപ്പാദിപ്പിക്കാൻ പ്രത്യേകം പരിപാലിക്കുന്ന പ്രദേശം." },
      "7": { "question": "തിരഞ്ഞെടുത്ത മികച്ച മരം (CPT) എന്താണ്?", "answer": "പ്രജനന പദ്ധതികളിൽ ഉപയോഗിക്കാനുള്ള സാധ്യതയും നല്ല സവിശേഷതകളും പരിഗണിച്ച് തിരഞ്ഞെടുത്ത മരം." },
      "8": { "question": "നഴ്സറി, SPA/CPT അല്ലെങ്കിൽ വിത്തുതോട്ടം രജിസ്റ്റർ ചെയ്യാൻ എന്ത് വിവരങ്ങൾ വേണം?", "answer": "സ്ഥലം, ലഭ്യമായ ഇനങ്ങൾ, ശേഷി, ബന്ധപ്പെട്ട വന ഡിവിഷൻ എന്നിവയുടെ വിവരങ്ങൾ വേണം." },
      "9": { "question": "വിത്തുതോട്ടം എന്താണ്?", "answer": "പുറത്തുള്ള ഗുണമേന്മ കുറഞ്ഞ ഉറവിടങ്ങളിൽ നിന്നുള്ള പരാഗണം കുറയ്ക്കാൻ വേർതിരിച്ചുവെക്കുന്ന ജനിതകമായി മികച്ച മരങ്ങളുടെ തോട്ടം." },
      "10": { "question": "വിത്ത് സംസ്കരണ-ചികിത്സ യൂണിറ്റ് എന്താണ്?", "answer": "ശേഖരിച്ച വിത്തുകൾ വൃത്തിയാക്കി, ചികിത്സിച്ച്, സംഭരിക്കാനോ വിതയ്ക്കാനോ തയ്യാറാക്കുന്ന കേന്ദ്രം." }
    }
  },
