# Copy this file to .env and fill in real values. Never commit .env to git.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Set to True only when frontend needs to send cookies/auth headers cross-origin
CORS_ALLOW_CREDENTIALS=False

# SQL Server. Trusted connection uses the Windows account running Django.
DB_ENGINE=mssql
DB_NAME=dbOSTPM
DB_HOST=localhost
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=True
# Set DB_TRUSTED_CONNECTION=False and provide DB_USER/DB_PASSWORD for SQL authentication.
DB_USER=
DB_PASSWORD=

# Generate a long random SECRET_KEY and provide production hostnames/origins.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# Production: set DEBUG=False, SECURE_SSL_REDIRECT=True, and SECURE_HSTS_SECONDS=31536000.
# Enable subdomains/preload only after confirming every subdomain is HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Optional integration credentials
RECAPTCHA_SECRET_KEY=
# Required only for the PARIVESH login integration
PARIVESH_SECRET_KEY=
