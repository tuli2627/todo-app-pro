# Copy this file to .env and fill in real values. Never commit .env to git.

SECRET_KEY=django-insecure-change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True only when frontend needs to send cookies/auth headers cross-origin
CORS_ALLOW_CREDENTIALS=False

DATABASE_URL=sqlite:///db.sqlite3
